# Environment Variables for Civora

# AI Chat Feature Control
# Set to 'true' to enable AI chat features (Vercel deployment)
# Set to 'false' to disable AI chat features (civora.me deployment)
NEXT_PUBLIC_CIVORA_AI_ENABLED=false

# API Keys for AI Assistant (required when AI is enabled)
GEMINI_API_KEY=your_gemini_api_key_here
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# Environment
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Server Port
PORT=3000

# Sentry (optional - for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_id_here
