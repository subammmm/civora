# Environment Variables for Civora

# ⚠️ IMPORTANT: Do not commit real API keys to public repositories
# This .env.example file is safe to commit (no real values)
# Copy to .env and replace with your actual keys

# ==============================================================================
# AI Chat Feature Control
# ==============================================================================
# Set to 'true' to enable AI chat features (Vercel deployment/testing)
# Set to 'false' to disable AI chat features (civora.me production deployment)
NEXT_PUBLIC_CIVORA_AI_ENABLED=false

# ==============================================================================
# AI Assistant APIs - REQUIRED for AI Assistant functionality
# ==============================================================================
# ❌ OpenAI API has been REMOVED (as of v53) - DO NOT USE OPENAI_API_KEY
# ✅ Only Gemini and LangSearch APIs are used now
#
# Get Gemini API key from: https://ai.google.dev/
# Get LangSearch API key from: https://langsearch.com/
#
# These are REQUIRED even if NEXT_PUBLIC_CIVORA_AI_ENABLED=false
# because the API route exists and validates keys at startup
GEMINI_API_KEY=your_gemini_api_key_here
LANGSEARCH_API_KEY=your_langsearch_api_key_here

# ==============================================================================
# Environment Configuration
# ==============================================================================
# Set to 'development' for local development
# Set to 'production' for deployed environments
NODE_ENV=development

# ==============================================================================
# CORS Configuration (Development Only)
# ==============================================================================
# In production (NODE_ENV=production), CORS is automatically set to:
#   - https://civora.me for civora.me deployment
#   - https://civora.me for Vercel deployments
# In development, use '*' to allow all origins
CORS_ORIGIN=*

# ==============================================================================
# Server Configuration (Development Only)
# ==============================================================================
# Port for local development server
# Vercel automatically assigns ports in production
PORT=3000

# ==============================================================================
# Optional Monitoring (Not Required)
# ==============================================================================
# Sentry for error tracking - optional, app works without it
# Uncomment and set if you want error monitoring
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Google Analytics - optional, app works without it
# Uncomment and set if you want analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_id_here

# ==============================================================================
# Notes for Deployment
# ==============================================================================
# For civora.me (Vercel Production):
#   - Set NEXT_PUBLIC_CIVORA_AI_ENABLED=false (AI chat hidden from users)
#   - Set NODE_ENV=production
#   - Add GEMINI_API_KEY and LANGSEARCH_API_KEY
#
# For Vercel Preview/Testing:
#   - Set NEXT_PUBLIC_CIVORA_AI_ENABLED=true (AI chat accessible)
#   - Set NODE_ENV=production
#   - Add GEMINI_API_KEY and LANGSEARCH_API_KEY
#
# DO NOT SET:
#   - OPENAI_API_KEY (removed, no longer used)
#   - FALLBACK_PROVIDER (removed, no longer used)

