# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=your-fernet-encryption-key

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://subammmm.github.io,https://*.vercel.app

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# External APIs (Optional - for future enhancements)
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Application Settings
APP_NAME=GlobalForge.ai
APP_VERSION=1.0.0
